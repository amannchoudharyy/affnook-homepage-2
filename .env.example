# Copy to .env.local for local overrides. Never commit real secrets.

# Deployment environment: development | staging | production.
# Search indexing is enabled ONLY when SITE_ENV=production AND SITE_URL is an https:// origin
# that is not *.vercel.app. A SITE_ENV=production build without such a SITE_URL fails.
# Vercel preview/staging deployments must keep SITE_ENV=staging.
SITE_ENV=development

# Absolute origin used for canonical URLs, sitemap and Open Graph. No trailing slash.
SITE_URL=http://localhost:3000
